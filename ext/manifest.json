{
  "manifest_version": 3,
  "name": "Konseki Sync",
  "version": "1.0",
  "description": "Passively syncs ッツ Reader session data to your local Konseki.",

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": ["storage", "activeTab", "scripting"],

  "background": {
    "scripts": ["background.js"]
  },
  "host_permissions": [
    "https://reader.ttsu.app/*",
    "http://127.0.0.1/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://reader.ttsu.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Konseki Sync",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
