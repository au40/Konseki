{
  "manifest_version": 3,
  "name": "Immersion Tracker Sync",
  "version": "1.0",
  "description": "Passively syncs ッツ Reader session data to your local Immersion Tracker.",

  "permissions": ["storage", "activeTab", "scripting"],

  "background": {
    "scripts": ["background.js"]
  },
  "host_permissions": [
    "https://reader.ttsu.app/*",
    "https://app.yatsu.moe/*",
    "http://127.0.0.1/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://reader.ttsu.app/*", "https://app.yatsu.moe/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Immersion Tracker Sync"
  }
}
