{
  "manifest_version": 3,
  "name": "Konseki Sync",
  "version": "1.0.6",
  "description": "Passively syncs ッツ Reader session data to your local Konseki.",

  "browser_specific_settings": {
    "gecko": {
      "id": "konseki-sync@immersion-tracker",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },

  "permissions": ["storage", "activeTab", "scripting"],

  "background": {
    "scripts": ["background.js"]
  },
  "host_permissions": [
    "https://reader.ttsu.app/*",
    "https://www.youtube.com/*",
    "http://127.0.0.1/*"
  ],

  "content_scripts": [
    {
      "matches": ["https://reader.ttsu.app/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["yt-track.js"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup.html",
    "default_title": "Konseki Sync",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  }
}
